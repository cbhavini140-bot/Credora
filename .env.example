# CREDORA Backend Environment Configuration
APP_NAME=CREDORA
APP_ENV=development
DEBUG=false

# PostgreSQL Database URL
DATABASE_URL=postgresql+psycopg2://credora:credora_dev_password@localhost:5432/credora_db

# JWT Security (replace with a strong random secret in production)
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paths to ML Models & Sample Datasets (relative to backend/ directory)
ML_MODELS_DIR=../ml_models
DATASETS_DIR=../datasets

# Upload & Simulation Limits
MAX_CSV_UPLOAD_MB=25
DEFAULT_RISK_MEDIUM_THRESHOLD=30
DEFAULT_RISK_HIGH_THRESHOLD=70
